# Convex writes these automatically the first time you run `pnpm setup`
# (`convex dev --until-success`) and log in / select a project — you
# normally don't need to set them by hand.
CONVEX_DEPLOYMENT=
CONVEX_URL=

# Clerk — the issuer domain from your Clerk JWT template
# (https://dashboard.clerk.com -> JWT Templates -> Convex)
CLERK_JWT_ISSUER_DOMAIN=
CLERK_SECRET_KEY=

# AWS Secrets Manager credentials
AWS_ACCESS_KEY_ID=
AWS_REGION=
AWS_SECRET_ACCESS_KEY=

# OpenAI — used by the AI agent and RAG embeddings
OPENAI_API_KEY=
